# =============================================================================
# CORTEX Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your API keys.
# NEVER commit .env to git — it contains secrets.
#
# Quick start: pick ONE provider below and set its key.
# OpenRouter (free) is the easiest: get a key at https://openrouter.ai/settings/keys
# =============================================================================

# --- Pick ONE primary provider (uncomment + set key) ---

# OpenRouter (free models + paid) — https://openrouter.ai/settings/keys
# OPENAI_API_KEY=sk-or-v1-your-key-here
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=deepseek/deepseek-v4-flash:free

# Groq (fast free inference) — https://console.groq.com/keys
# GROQ_API_KEY=gsk_your-key-here
# CORTEX_GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# NVIDIA NIM (free) — https://build.nvidia.com
# NVIDIA_API_KEY=nvapi-your-key-here
# NVIDIA_MODEL_ID=deepseek-ai/deepseek-v4-pro

# HuggingFace (free) — https://huggingface.co/settings/tokens
# HF_TOKEN=hf_your-token-here

# OpenAI (paid) — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude (paid) — https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google Gemini — https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-key-here

# DeepSeek — https://platform.deepseek.com/
# OPENAI_API_KEY=your-key-here
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# Ollama (local, no key needed) — brew install ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.2:3b

# =============================================================================
# MCP Server Credentials (optional — only if using these services)
# =============================================================================
# GITHUB_TOKEN=ghp_your-token-here
# SLACK_BOT_TOKEN=xoxb-your-token-here
# SLACK_TEAM_ID=T00000000
# LINEAR_API_KEY=lin_api_your-key-here
# EXA_API_KEY=your-key-here
# TAVILY_API_KEY=tvly-your-key-here

# MCP — Google services (OAuth, needs Google Cloud project)
# GOOGLE_OAUTH_CREDENTIALS=/path/to/gcp-oauth.keys.json
# GOOGLE_DRIVE_OAUTH_CREDENTIALS=/path/to/gcp-oauth.keys.json

# MCP — Microsoft Outlook (OAuth, needs Azure app registration)
# MS_CLIENT_ID=your-client-id
# MS_CLIENT_SECRET=your-client-secret

# MCP — Notion (free token from https://www.notion.so/profile/integrations)
# NOTION_TOKEN=ntn_your-token-here

# MCP — Todoist (free token from Settings > Integrations > Developer)
# TODOIST_API_KEY=your-token-here

# MCP — Airtable (free API key from https://airtable.com/create/tokens)
# AIRTABLE_API_KEY=keyxxxxx
# AIRTABLE_BASE_ID=appxxxxx

# MCP — n8n (self-hosted is free, needs API key from n8n settings)
# N8N_BASE_URL=https://your-n8n-instance.com
# N8N_API_KEY=your-api-key-here

# =============================================================================
# Optional Tuning
# =============================================================================
MCP_TIMEOUT=180000
CORTEX_SIMPLE=1
CORTEX_ALLOW_OPEN=1
CORTEX_AUTO_OPEN=1
